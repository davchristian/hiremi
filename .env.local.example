# Copy to .env.local and fill in. See the README's "Environment variables" table.

# Supabase → Project Settings → API (bare host, no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never expose it
SUPABASE_SERVICE_ROLE_KEY=

# Database → Connection string → transaction pooler (port 6543). Percent-encode @ : / # ? in the password.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Optional: without it listings are stored unembedded and the feed sorts by date
VOYAGE_API_KEY=

# Any long random string; set the same value in Vercel for the scheduled ingest
CRON_SECRET=

# Optional tuning
# REFRESH_INTERVAL_HOURS=72
# DISCOVERY_SOURCES_PER_RUN=4
